// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum LocationVariant {
  CITY
  DUNGEON
  FOREST
  VILLAGE
}

enum EventType {
  BATTLE
  QUEST
  ENCOUNTER
}

model Channel {
  id        String    @id @default(uuid())
  name      String    @unique
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  text      String
  channelId String
  authorId  Int
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                   Int            @id @default(autoincrement())
  email                String         @unique
  password             String
  name                 String
  gender               Gender?
  country              String?
  city                 String?
  language             String?
  hashedRefreshToken   String?
  messages             Message[]
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt
  gameProfile          GameProfile?
  userLocation         UsersLocation?
}

model GameProfile {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  gold       Int @default(0)
  experience Int @default(0)
  level      Int @default(1)

  inventory         InventoryItem[]
  profileAttributes ProfileAttribute[]
  profileStats      ProfileStat[]
}

enum AttributeType {
  STRENGTH
  AGILITY
  ENDURANCE
  WISDOM
  CHARISMA
}

model Attribute {
  id          Int           @id @default(autoincrement())
  name        AttributeType @unique
  description String?

  profiles ProfileAttribute[]
  items    ItemAttribute[]
  monsterAttributes MonsterAttribute[]
}

enum StatType {
  HEALTH
  MANA
  DAMAGE
  DEFENSE
  CRIT
  DODGE
  CRIT_DAMAGE
}

model Stat {
  id          Int      @id @default(autoincrement())
  name        StatType @unique
  description String?

  profiles ProfileStat[]
  items    ItemStat[]
}

model ProfileAttribute {
  gameProfileId Int
  attributeId   Int
  value         Int @default(0)

  gameProfile GameProfile @relation(fields: [gameProfileId], references: [id], onDelete: Cascade)
  attribute   Attribute   @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([gameProfileId, attributeId])
}

model ProfileStat {
  gameProfileId Int
  statId        Int
  value         Float @default(0)

  gameProfile GameProfile @relation(fields: [gameProfileId], references: [id], onDelete: Cascade)
  stat        Stat        @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@id([gameProfileId, statId])
}

model ItemAttribute {
  itemId      Int
  attributeId Int
  value       Int @default(0)

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([itemId, attributeId])
}

model ItemStat {
  itemId Int
  statId Int
  value  Float @default(0)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stat Stat @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@id([itemId, statId])
}

model Item {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  description   String          @default("")
  price         Int             @default(0)
  icon          String          @default("")
  quantity      Int             @default(1)
  isConsumable  Boolean         @default(false)
  rarity        ItemRarity      @default(COMMON)
  equipmentType EquipmentType[] @default([UNKNOWN])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  attributes    ItemAttribute[]
  stats         ItemStat[]
  inventoryItem InventoryItem[]
}

enum ItemRarity {
  QUEST
  COMMON
  MAGIC
  RARE
  UNIQUE
}

enum EquipmentType {
  WEAPON
  SHIELD
  BODY
  HELMET
  BOOTS
  GLOVES
  LEGS
  RING
  AMULET
  SCROLL
  POTION
  UNKNOWN
}

model InventoryItem {
  id            Int      @id @default(autoincrement())
  gameProfileId Int
  itemId        Int
  quantity      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  slot          Int
  isEquiped     Boolean

  gameProfile GameProfile @relation(fields: [gameProfileId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([gameProfileId, itemId])
}

model Location {
  id        Int             @id @default(autoincrement())
  name      String
  variant   LocationVariant
  eventType EventType

  userLocations UsersLocation[]
}

model UsersLocation {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  locationId Int
  isForced   Boolean @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Monster {
  id              Int    @id @default(autoincrement())
  name            String @unique
  description     String?
  level           Int    @default(1)
  rewardGold      Int    @default(0)
  rewardExperience Int   @default(0)
  icon            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  attributes MonsterAttribute[]
}

model MonsterAttribute {
  monsterId   Int
  attributeId Int
  value       Int @default(0)

  monster   Monster   @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([monsterId, attributeId])
}
